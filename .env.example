# ==============================================================================
# Template Environment Variables — Sistem Bimbingan Skripsi (Kelompok A4)
# ==============================================================================
# Petunjuk penggunaan:
# 1. Salin file ini menjadi `.env`: `cp .env.example .env`
# 2. Isi `POSTGRES_PASSWORD` dengan password acak URL-safe (hex), misalnya:
#      openssl rand -hex 32
# 3. Gunakan nilai password yang sama persis pada `POSTGRES_PASSWORD` dan `DATABASE_URL`.
# 4. Untuk `POSTGRES_DB` dan `POSTGRES_USER`, gunakan identifier sederhana
#    (huruf kecil, angka, atau underscore) agar tidak memerlukan URL encoding.
# 5. JANGAN pernah meng-commit `.env` atau credential asli ke repository Git.
# 6. Variabel autentikasi (JWT/cookie) dan batas upload akan ditambahkan pada
#    SBS-05 dan SBS-09 sesuai kebutuhan modul terkait.

# Runtime & Binding
NODE_ENV=development
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Bind address API pada development lokal: 127.0.0.1
# Di dalam Docker Compose (compose.yaml), service `api` otomatis override ke 0.0.0.0
API_HOST=127.0.0.1
API_PORT=3000

# Origin frontend yang diizinkan oleh CORS backend
# Untuk pengembangan lokal Vite: http://localhost:5173
# Untuk akses stack Docker Compose lokal: http://127.0.0.1:8080
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
POSTGRES_DB=sbs_dev
POSTGRES_USER=sbs_dev_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Untuk pengembangan lokal (compose.dev.yaml), host database adalah 127.0.0.1:5432.
# Saat berjalan di dalam stack full container (compose.yaml), service `api`
# otomatis membentuk koneksi menggunakan hostname internal `db:5432`.
DATABASE_URL=postgresql://sbs_dev_user:CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32@127.0.0.1:5432/sbs_dev?schema=public

# Direktori penyimpanan upload privat (digunakan oleh API backend, bukan static publik)
UPLOAD_DIR=./storage/revisions
