# ==============================================================================
# Template Environment Variables — Sistem Bimbingan Skripsi (Kelompok A4)
# ==============================================================================
# Catatan SBS-01:
# - Ini adalah template placeholder awal untuk bootstrap monorepo.
# - Salin file ini menjadi `.env` untuk konfigurasi lokal dan isi dengan nilai Anda.
# - JANGAN pernah melakukan commit file `.env` atau credential asli ke repository.
# - Variabel tambahan akan ditambahkan pada work item berikutnya sesuai kebutuhan.

# Aplikasi & Server
NODE_ENV=development
# Target domain produksi: https://sbs.kxrumii.my.id
APP_URL=http://localhost:5173
SERVER_PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
POSTGRES_DB=sbs_dev
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@localhost:5432/sbs_dev?schema=public

# Autentikasi & Sesi
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
COOKIE_SECURE=false

# Penyimpanan Berkas Revisi (Privat, maks. 10 MiB)
UPLOAD_DIR=./storage/revisions
UPLOAD_MAX_BYTES=10485760
