# ==============================================================================
# Template Environment Variables — Sistem Bimbingan Skripsi (Kelompok A4)
# ==============================================================================
# Petunjuk penggunaan:
# 1. Salin file ini menjadi `.env`: `cp .env.example .env`
# 2. Ganti seluruh placeholder `CHANGE_ME_*` dengan nilai aman sebelum menjalankan stack.
# 3. JANGAN pernah meng-commit `.env` atau credential asli ke repository Git.
# 4. Variabel autentikasi (JWT/cookie) dan batas upload akan ditambahkan pada
#    SBS-05 dan SBS-09 sesuai kebutuhan modul terkait.

# Runtime & Port
NODE_ENV=development
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
API_PORT=3000

# Origin frontend yang diizinkan oleh CORS backend
# Untuk pengembangan lokal Vite: http://localhost:5173
# Untuk akses stack Docker Compose lokal: http://127.0.0.1:8080
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
POSTGRES_DB=sbs_dev
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Untuk pengembangan lokal dengan database di host/forwarded port: gunakan host `localhost`
# Saat berjalan di dalam Docker Compose, service `api` otomatis menggunakan hostname service `db`
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@localhost:5432/sbs_dev?schema=public

# Direktori penyimpanan upload privat (digunakan oleh API backend, bukan static publik)
UPLOAD_DIR=./storage/revisions
